parameters:
	ignoreErrors:
		-
			message: '#^Offset 0 on array\{string, int\<\-1, max\>\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: Html/Headings.php

		-
			message: '#^Strict comparison using \=\=\= between '''' and non\-empty\-string will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: Html/Headings.php

		-
			message: '#^Parameter \#1 \.\.\.\$arg1 of function min expects non\-empty\-array, array\<int\<0, max\>, int\> given\.$#'
			identifier: argument.type
			count: 1
			path: Html/Prose.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(string\)\: bool\)\|null, ''trim'' given\.$#'
			identifier: argument.type
			count: 2
			path: Html/Prose.php

		-
			message: '#^Cannot access an offset on list\<Omnidocs\\Model\\Heading\>\|Omnidocs\\Model\\Heading\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: OnePage.php

		-
			message: '#^Method Omnidocs\\OnePage\:\:toc\(\) should return list\<array\{heading\: Omnidocs\\Model\\Heading, children\: list\<Omnidocs\\Model\\Heading\>\}\> but returns list\<array\<''children''\|''heading'', list\<Omnidocs\\Model\\Heading\>\|Omnidocs\\Model\\Heading\>\>\.$#'
			identifier: return.type
			count: 1
			path: OnePage.php

		-
			message: '#^Method Omnidocs\\Support\\Path\:\:order\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Support/Path.php

		-
			message: '#^Method Omnidocs\\Support\\Path\:\:split\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: Support/Path.php

		-
			message: '#^Parameter \#2 \$string of function explode expects string, string\|null given\.$#'
			identifier: argument.type
			count: 1
			path: Support/Path.php

		-
			message: '#^Method Omnidocs\\Testing\\RecordingLinker\:\:file\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: Testing/RecordingLinker.php

		-
			message: '#^Method Omnidocs\\Testing\\RecordingLinker\:\:image\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: Testing/RecordingLinker.php

		-
			message: '#^Call to static method PHPUnit\\Framework\\Assert\:\:assertIsList\(\) with list\<Omnidocs\\Model\\Symbol\> will always evaluate to true\.$#'
			identifier: staticMethod.alreadyNarrowedType
			count: 1
			path: Testing/SourceContractTests.php

		-
			message: '#^Method Omnidocs\\SourceInterface@anonymous/Tests/ModelTest\.php\:17\:\:home\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: Tests/ModelTest.php

		-
			message: '#^Method Omnidocs\\SourceInterface@anonymous/Tests/ModelTest\.php\:17\:\:page\(\) never returns null so it can be removed from the return type\.$#'
			identifier: return.unusedType
			count: 1
			path: Tests/ModelTest.php
